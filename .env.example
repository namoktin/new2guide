# ========================================================
# 2GUIDE - HỆ THỐNG VI ĐỊNH VỊ & THUYẾT MINH DI TÍCH
# CẤU HÌNH MÔI TRƯỜNG MẪU (ENVIRONMENT TEMPLATE)
# Sao chép tệp này thành .env và điền các khóa bí mật của bạn
# ========================================================

# 1. CẤU HÌNH CỔNG MÁY CHỦ (SERVER PORT)
PORT=4000

# 2. KHU DI TÍCH HOẠT ĐỘNG THỰC ĐỊA
SITE_CODE=HL
SITE_NAME=Nhà Tổng Thống

# 3. CƠ SỞ DỮ LIỆU ĐÁM MÂY (MONGODB ATLAS - BẮT BUỘC)
# Ví dụ: mongodb+srv://<username>:<password>@cluster0.mongodb.net/2guide?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/2guide?retryWrites=true&w=majority

# 4. TRÍ TUỆ NHÂN TẠO HƯỚNG DẪN VIÊN (GROQ CLOUD AI - BẮT BUỘC)
# Đăng ký nhận khóa miễn phí tại: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 5. BẢO MẬT & PHÂN QUYỀN BAN QUẢN LÝ (SECURITY & ACCESS CONTROL - NÊN DÙNG)
# Đường dẫn bảo mật truy cập cổng điều hành Ban Quản Lý (thay thế /admin hoặc /quanly)
ADMIN_SECRET_PATH=/quanly_bql_8869

# Khóa xác thực quyền điều hành quản trị viên BQL
ADMIN_SECRET_KEY=bql_sec_2026_x89a3f

# Khóa xác thực hai chiều chống dữ liệu vi định vị giả mạo từ thiết bị ESP32
ESP32_SECRET_KEY=esp_sec_2026_98a72b

# 6. STUDIO BIÊN TẬP BẢN ĐỒ & HIỆN VẬT (MAP STUDIO - TÙY CHỌN NÂNG CAO)
EDITOR_SECRET_PATH=/editor_bql_7749
EDITOR_SECRET_KEY=editor_sec_2026_z91k4c
